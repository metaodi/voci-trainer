{
  "name": "voci-trainer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Karteikarten-App zum Lernen von Englisch- und Französisch-Vokabeln",
  "scripts": {
    "dev": "vite",
    "build": "npm run check-lektionen && tsc --noEmit && vite build",
    "preview": "vite preview",
    "check-lektionen": "node scripts/check-lektionen.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "icons": "node scripts/erzeuge-icons.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
